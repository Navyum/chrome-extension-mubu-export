{
  "manifest_version": 3,
  "name": "幕布导出工具 | 一键批量导出到本地",
  "version": "0.1.0",
  "description": "从幕布（mubu.com）批量导出大纲 & 思维导图为 Markdown/OPML/JSON，保留文件夹层级结构。",
  "permissions": [
    "cookies",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.mubu.com/*",
    "https://api2.mubu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "幕布导出工具"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  }
} 